# Konfigurasi database MySQL
# Salin file ini menjadi `.env` lalu isi nilainya.
# File `.env` sudah masuk .gitignore — jangan commit kredensial asli.

# Opsi 1: URI lengkap (jika diisi, override semua di bawah)
# DATABASE_URL=mysql://user:password@host:3306/dbname

# Opsi 2: setting terpisah
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=xavier_wedding

# HTTP server
PORT=3100
HOST=127.0.0.1

# Set 1 saat deploy di HTTPS
# COOKIE_SECURE=1
